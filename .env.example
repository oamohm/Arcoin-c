# ARCOIN — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.

# ── ARC NETWORK ─────────────────────────────────────────────
NEXT_PUBLIC_ARC_CHAIN_ID=5042002
# Optional: Alchemy/QuickNode key for backup RPC
NEXT_PUBLIC_ALCHEMY_KEY=

# ── PRIVY AUTH ───────────────────────────────────────────────
# Get from: https://dashboard.privy.io → Your App → App ID
NEXT_PUBLIC_PRIVY_APP_ID=

# ── WALLETCONNECT ────────────────────────────────────────────
# Get from: https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_ID=

# ── ANTHROPIC (AI Help — Phase 5) ───────────────────────────
# Get from: https://console.anthropic.com
# SERVER-SIDE ONLY — never use NEXT_PUBLIC_ prefix
ANTHROPIC_API_KEY=

# ── APP ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# ── PHASE 3 UPGRADE HOOKS (leave blank for now) ──────────────
# NEXT_PUBLIC_CHAINALYSIS_KEY=
# NEXT_PUBLIC_TRM_KEY=


